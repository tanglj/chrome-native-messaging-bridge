{
  "manifest_version": 3,
  "name": "Chrome Native Messaging Bridge",
  "version": "0.2.0",
  "key": "",
  "description": "用于受控认证请求的本地 Chrome 原生消息桥接。",
  "action": {
    "default_title": "Native Bridge",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "cookies",
    "nativeMessaging",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
